{
  "name": "iutverse",
  "version": "3.0.0",
  "private": true,
  "description": "IUTverse: campus platform for the IUT community. One Next.js app serves the UI and the API.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "test:db": "supabase test db",
    "migrate:supabase": "node scripts/applySupabaseMigrations.js",
    "security:bootstrap-roles": "node scripts/bootstrapSecurityRoles.js",
    "security:provision-accounts": "node scripts/provisionPrivilegedAccounts.js",
    "security:scan-env": "node scripts/scanSecrets.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.66.9",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "redis": "^5.12.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "supabase": "^2.121.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.1"
    }
  }
}
