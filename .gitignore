# One ignore file for the whole repo (client/, server/, docs/, docker/).

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment and secrets. Example files are committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
**/privileged-accounts.local.json
user iutverse.txt

# Logs
logs/
*.log

# Test, coverage and mutation-testing output
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
.stryker-tmp/
server/reports/

# Local platform and tool state
.vercel/
.netlify/
server/supabase/.branches/
server/supabase/.temp/
*.tmp
*.temp

# Files uploaded to the pre-Supabase server (personal data; now in Storage)
server/uploads/

# Security reports with exploit details (keep local only)
AUDIT-REPORT-*.md
DIFFERENTIAL-REVIEW-*.md

# AI agent tooling
.claude/
.agents/
skills-lock.json
CLAUDE.local.md

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# OS files
.DS_Store
Thumbs.db
Desktop.ini
._*
