# One ignore file for the whole repo (src/, supabase/, scripts/, docs/, docker/).

# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/
next-env.d.ts
*.tsbuildinfo

# Environment and secrets. Example files are committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
**/privileged-accounts.local.json
user iutverse.txt

# Logs
logs/
*.log

# Test, coverage and mutation-testing output
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
.stryker-tmp/
reports/

# Local platform and tool state
.vercel/
.netlify/
supabase/.branches/
supabase/.temp/
*.tmp
*.temp

# Local leftovers of the pre-Next.js layout (client/ and server/). They hold env
# files, uploads with personal data and node_modules, so nothing there is ever tracked.
/client/
/server/

# Security reports with exploit details (keep local only)
AUDIT-REPORT-*.md
DIFFERENTIAL-REVIEW-*.md

# AI agent tooling
.claude/
.agents/
skills-lock.json
CLAUDE.local.md

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# OS files
.DS_Store
Thumbs.db
Desktop.ini
._*
