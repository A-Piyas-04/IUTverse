# IUTverse Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Exact client origins, comma-separated. Required in production; '*' is rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CREATE_MAX=60
RATE_LIMIT_LOOKUP_MAX=20
# Shared store for rate limits and caches; required for serverless scale-out.
# Any Redis-protocol URL, e.g. Upstash: rediss://default:<token>@<host>:6379
REDIS_URL=
# Reverse-proxy hops to trust for client IPs. Defaults to 1 on Vercel, 0 elsewhere.
TRUST_PROXY=
# Local debugging only: include internal error detail in 5xx responses.
EXPOSE_ERRORS=false
# Where Supabase password-reset emails link to. Must be on the Supabase Auth
# redirect allowlist as an exact URL. Empty uses the project's Site URL.
PASSWORD_RESET_REDIRECT_URL=

# Supabase API Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Trusted machine / CI only. Never set these in Vercel or any deployed host.
# ---------------------------------------------------------------------------
# Supabase Postgres connection strings used by scripts/applySupabaseMigrations.js.
DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres

# Required once after the critical security migration. Current profile roles are
# intentionally reset and only these confirmed accounts regain privilege.
BOOTSTRAP_ADMIN_EMAILS=admin@iut-dhaka.edu
BOOTSTRAP_MODERATOR_EMAILS=

# Frontend Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Email Configuration
# Required only for features that send email directly from this Express server.
# Supabase Auth password reset emails are configured in the Supabase dashboard.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# Notes:
# - For Gmail, you need to generate an "App Password" instead of using your regular password
# - Enable 2FA on your Gmail account and generate an app password from Google Account settings
# - For other email services, adjust EMAIL_SERVICE accordingly (e.g., 'outlook', 'yahoo')
