{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --project server --testNamePattern \"^(?!.*(BUG-051|authorizes at runtime)).*$\""
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/server/controllers/communityController.ts",
    "src/server/controllers/securityController.ts",
    "src/server/middleware/*.ts"
  ],
  "ignorePatterns": [
    ".env",
    ".env.*",
    ".next",
    "client",
    "server",
    "node_modules",
    "reports",
    "coverage",
    "supabase/.temp",
    "supabase/.branches"
  ],
  "concurrency": 4,
  "timeoutMS": 30000,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
