#!/bin/sh
# Blocks commits that stage credentials. Enable once per clone with:
#   git config core.hooksPath .githooks
set -e

repo_root=$(git rev-parse --show-toplevel)

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner \
    --config "$repo_root/.gitleaks.toml" "$repo_root"
else
  echo "pre-commit: gitleaks not found on PATH; running the built-in scanner only." >&2
  echo "pre-commit: install it from https://github.com/gitleaks/gitleaks#installing" >&2
fi

node "$repo_root/scripts/scanSecrets.js" --staged
