{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-skip-pattern=\"BUG-051|runtime authorization uses protected security context\" test/unit/*.test.js"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/controllers/v2Controller.js",
    "src/controllers/securityController.js",
    "src/middleware/*.js"
  ],
  "ignorePatterns": [
    ".env",
    ".env.*",
    "uploads",
    "prisma",
    "reports",
    "coverage",
    "supabase/.temp",
    "supabase/.branches"
  ],
  "concurrency": 4,
  "timeoutMS": 30000,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
